# Copie este arquivo para `.env` e preencha os valores.
# O arquivo `.env` NÃO é versionado (ver .gitignore).

# --- Provedor do modelo (Anthropic) ---
ANTHROPIC_API_KEY=sk-ant-...
# Modelo usado pelo agente. Pode ser trocado sem alterar o código.
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_MAX_TOKENS=1024

# --- Dados ---
# Pasta com os CSVs e o PDF de políticas fornecidos pela loja.
DATA_DIR=data
# Pasta onde ficam os artefatos gerados (banco SQLite, histórico de conversas).
STORAGE_DIR=storage

# --- Comportamento ---
# Fuso horário da loja (Campo Grande/MS), usado para horário de funcionamento e prazos.
STORE_TIMEZONE=America/Campo_Grande
# Opcional: fixa a "data de hoje" do agente (AAAA-MM-DD) para reproduzir cenários.
# Deixe vazio para usar a data real.
STORE_TODAY=
# Opcional: lojas parceiras sugeridas quando o cliente pede acessórios (cordas, cabos, pedais...),
# que a Empório não vende (manual §7.1). Separe por ";". Vazio = o agente apenas redireciona,
# sem citar nomes de lojas.
# Ex.: PARTNER_STORES=Casa do Acessório - (67) 3000-0000; Som & Cia - somecia.com.br
PARTNER_STORES=

# --- API HTTP ---
API_HOST=127.0.0.1
API_PORT=8000

