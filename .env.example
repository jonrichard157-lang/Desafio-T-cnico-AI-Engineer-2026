# Copy this file to `.env` and fill in the values.
# The `.env` file is NOT versioned (see .gitignore).

# --- Model provider (Anthropic) ---
ANTHROPIC_API_KEY=sk-ant-...
# Model used by the agent. Can be changed without touching the code.
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_MAX_TOKENS=1024

# --- Data ---
# Folder with the CSVs and the policy PDF provided by the store.
DATA_DIR=data
# Folder for generated artifacts (SQLite database).
STORAGE_DIR=storage

# --- Behavior ---
# Store timezone (Campo Grande/MS), used for opening hours and deadlines.
STORE_TIMEZONE=America/Campo_Grande
# Optional: pins the agent's "today" (YYYY-MM-DD) or date and time (YYYY-MM-DDTHH:MM)
# to reproduce scenarios. The conversations in examples/ use 2026-02-20T10:30.
# Leave empty to use the real date.
STORE_TODAY=
# Optional: partner stores suggested when the customer asks for accessories (strings, cables,
# pedals...), which Empório does not sell (manual section 7.1). Separate them with ";".
# Empty = the agent just redirects, without naming any store.
# E.g.: PARTNER_STORES=Casa do Acessório - (67) 3000-0000; Som & Cia - somecia.com.br
PARTNER_STORES=
